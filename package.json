{
	"name": "fln",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "wrangler types",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply fln --local",
		"db:migrate:cf": "wrangler d1 migrations apply fln --remote",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@iconify/json": "^2.2.517",
		"@libsql/client": "^0.17.4",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.20.1",
		"drizzle-kit": "^1.0.0-rc.4",
		"drizzle-orm": "^1.0.0-rc.4",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"unplugin-icons": "^23.0.1",
		"vite": "^7.3.6",
		"vite-plugin-devtools-json": "^1.1.0",
		"wrangler": "^4.123.0"
	},
	"dependencies": {
		"zod": "^4.4.3"
	}
}
